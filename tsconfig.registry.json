{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "incremental": false,
    // Type-check like a plain React app: no Next.js globals (styled-jsx) and no Node types (NodeJS.*).
    "types": [],
    "plugins": []
  },
  "include": ["src/registry/**/*.ts", "src/registry/**/*.tsx"],
  "exclude": ["src/registry/__generated__"]
}
